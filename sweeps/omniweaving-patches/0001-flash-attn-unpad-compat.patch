 from einops import rearrange
 
 
+def _unpad_compat(x, mask):
+    """兼容 flash_attn 的两个 API：老版 unpad_input 返回 4 项，新版返回 5 项。
+    DCU 镜像里的 flash_attn 是 4 项版本，而上游代码按 5 项解包 → ValueError。"""
+    r = unpad_input(x, mask)
+    if len(r) == 5:
+        return r
+    x_unpad, indices, cu_seqlens, max_s = r
+    return x_unpad, indices, cu_seqlens, max_s, None
+
+
 def flash_attn_no_pad(
     qkv, key_padding_mask, causal=False, dropout_p=0.0, softmax_scale=None, deterministic=False
 ):
